{
  "name": "frankenstein-stage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Lane C: the Stage. Game scenes driven by the run event stream.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "server": "node server/index.mjs",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "shots": "node scripts/shots.mjs",
    "qa": "node scripts/qa.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "playwright-core": "^1.56.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
